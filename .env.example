# Server-only values: never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_IDS=
BACKEND_URL=https://YOUR_APP.vercel.app
# MINI_APP_URL is accepted only as a legacy backend URL fallback.
ALLOWED_ORIGINS=https://YOUR_ADMIN.vercel.app,https://YOUR_APP.vercel.app
OFERTA_URL=
SUPPORT_USERNAME=
# Optional frontend API root, including /api. User app defaults to /api.
VITE_API_URL=/api

# Optional real sticker file_id from this bot. Failure never blocks /start.
WELCOME_STICKER_FILE_ID=

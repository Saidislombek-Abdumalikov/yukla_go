# ==============================================================================
# YUKLA GO - ENVIRONMENT (.env.example)  ->  copy to .env, NEVER commit .env
# All values are SERVER-SIDE ONLY. Never prefix with VITE_.
# ==============================================================================

# Telegram bot token from @BotFather
BOT_TOKEN=

# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# Public URL of the Mini App
MINI_APP_URL=https://your-app.vercel.app

# Supabase (service role key = full DB access, keep secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. At least 32 random characters. There is no default: without it
# nobody can log in. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: extra admin Telegram IDs (comma separated). The two built-in
# admin IDs always work. Admin status is decided ONLY from the Telegram ID that
# Telegram itself signed - there is no admin password or key any more.
ADMIN_TELEGRAM_IDS=

# Local development only (never set on Vercel): lets you log in without Supabase
# ALLOW_DEV_AUTH=1

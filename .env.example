# ==============================================================================
# YUKLA GO — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NOTE: All these variables are SERVER-SIDE ONLY.
# NEVER prefix with VITE_ or expose to client-side bundles.

# Telegram Bot
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_token_here
MINI_APP_URL=https://yuklago.vercel.app

# Supabase (PostgreSQL Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# JWT Session Security
JWT_SECRET=your_super_strong_random_jwt_secret_key_here
